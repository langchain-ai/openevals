# Obtain from your OpenAI and LangSmith accounts. Do not commit the filled .env file.
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=companyscope-langsmith-lab
LANGSMITH_DATASET=companyscope-evidence-v1
# US org: https://api.smith.langchain.com
# EU org: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
CANDIDATE_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
